    {
      "name": "12. Products - Update Product Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Fields updated\", function () {",
              "    pm.expect(Number(jsonData.data.price)).to.eql(160);",
              "    pm.expect(Number(jsonData.data.salePrice)).to.eql(145);",
              "    pm.expect(jsonData.data.position).to.eql(5);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"price\": 160.00,\n    \"salePrice\": 145.00,\n    \"position\": 5,\n    \"description\": \"Updated description with clinical glow testing\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        }
      }
    },
    {
      "name": "13. Products - Toggle Status (Deactivate)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Product deactivated\", function () {",
              "    pm.expect(jsonData.data.isActive).to.eql(false);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"isActive\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}", "status"]
        }
      }
    },
