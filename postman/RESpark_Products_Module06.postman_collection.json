          "raw": "{\n    \"username\": \"{{receptionistUsername}}\",\n    \"password\": \"{{receptionistPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "03. Setup - Create Test Product Category",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Category created (201)\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Category ID extracted\", function () {",
              "    pm.expect(jsonData.data.id).to.be.a('string');",
              "    pm.environment.set(\"categoryId\", jsonData.data.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Postman Category \" + Date.now(),\n    \"position\": 1,\n    \"group\": \"Both\",\n    \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-categories",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-categories"]
        }
      }
    },
    {
      "name": "04. Products - Auto-generate Barcode",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Valid numeric barcode returned\", function () {",
              "    pm.expect(jsonData.data.barcode).to.be.a('string');",
              "    pm.expect(jsonData.data.barcode.length).to.be.at.least(10);",
              "    pm.environment.set(\"generatedBarcode\", jsonData.data.barcode);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
