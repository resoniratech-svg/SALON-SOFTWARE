{
  "info": {
    "_postman_id": "respark-module-06-products-suite",
    "name": "RESpark - Module 06: Products Suite",
    "description": "Complete test and integration suite for RESpark Module 06: Products. Includes automated token extraction, category dependency setup, barcode generator, CRUD operations, filter & search validations, RBAC checks, integrity checks, and cleanup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Auth - Admin Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Admin token acquired\", function () {",
              "    pm.expect(jsonData.data.token).to.be.a('string');",
              "    pm.environment.set(\"adminToken\", jsonData.data.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{adminUsername}}\",\n    \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "02. Auth - Receptionist Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Receptionist token acquired\", function () {",
