    {
      "name": "Security & RBAC",
      "item": [
        {
          "name": "22 Tenant Spoofing",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Spoofed tenantId is ignored and assigned to Tenant A\", function () {",
                  "    pm.expect(jsonData.data.tenantId).to.not.eql(\"00000000-0000-0000-0000-000000000002\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
