            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Acquire receptionist token if missing",
                  "if (!pm.environment.get(\"tokenReceptionist\")) {",
                  "    pm.sendRequest({",
                  "        url: pm.environment.get(\"baseUrl\") + '/api/auth/login',",
                  "        method: 'POST',",
                  "        header: { 'Content-Type': 'application/json' },",
                  "        body: {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify({",
                  "                username: pm.environment.get(\"receptionistUsername\") || 'receptionist',",
                  "                password: pm.environment.get(\"receptionistPassword\") || 'DevelopmentPassword123!'",
                  "            })",
                  "        }",
                  "    }, function (err, res) {",
                  "        if (!err && res.code === 200) {",
                  "            pm.environment.set(\"tokenReceptionist\", res.json().data.token);",
                  "        }",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 (Receptionist can READ products)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenReceptionist}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
