    {
      "name": "06. Disposables - Create Full Specification Disposable (Large Gloves)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Fields matched accurately\", function () {",
              "    pm.expect(jsonData.data.name).to.eql(\"Large Gloves\");",
              "    pm.expect(jsonData.data.code).to.eql(\"DISP-GLV-001\");",
              "    pm.expect(Number(jsonData.data.price)).to.eql(25.5);",
              "    pm.expect(Number(jsonData.data.salePrice)).to.eql(20);",
              "    pm.expect(Number(jsonData.data.quantity)).to.eql(100);",
              "    pm.expect(jsonData.data.unit).to.eql(\"box\");",
              "    pm.expect(jsonData.data.isNonDiscountable).to.eql(true);",
              "    pm.environment.set(\"disposableId\", jsonData.data.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Large Gloves\",\n    \"code\": \"DISP-GLV-001\",\n    \"category\": \"Disposables\",\n    \"categoryId\": \"{{testCategoryId}}\",\n    \"price\": 25.50,\n    \"salePrice\": 20.00,\n    \"quantity\": 100,\n    \"unit\": \"box\",\n    \"gender\": \"Both\",\n    \"isRetail\": false,\n    \"hideFromCatalogue\": false,\n    \"isNonDiscountable\": true,\n    \"description\": \"Latex powder-free examination gloves, Large size\",\n    \"barcode\": \"{{generatedBarcode}}\",\n    \"position\": 1,\n    \"hsnCode\": \"4015\",\n    \"productTag\": \"Sanitation\",\n    \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/disposables",
          "host": ["{{baseUrl}}"],
          "path": ["api", "disposables"]
        }
      }
    },
