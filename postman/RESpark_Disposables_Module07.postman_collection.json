    {
      "name": "05. Disposables - Create Minimal Disposable (Defaults)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Default values applied properly\", function () {",
              "    pm.expect(jsonData.data.name).to.eql(\"Standard Wooden Spatula\");",
              "    pm.expect(jsonData.data.category).to.eql(\"Disposables\");",
              "    pm.expect(Number(jsonData.data.price)).to.eql(0);",
              "    pm.expect(Number(jsonData.data.quantity)).to.eql(1);",
              "    pm.expect(jsonData.data.unit).to.eql(\"pcs\");",
              "    pm.expect(jsonData.data.gender).to.eql(\"Both\");",
              "    pm.expect(jsonData.data.isRetail).to.eql(false);",
              "    pm.expect(jsonData.data.isActive).to.eql(true);",
              "    pm.environment.set(\"minimalDisposableId\", jsonData.data.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Standard Wooden Spatula\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/disposables",
          "host": ["{{baseUrl}}"],
          "path": ["api", "disposables"]
        }
      }
