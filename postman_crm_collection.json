    {
      "name": "3. CRM Table Listing & Advanced Filters",
      "item": [
        {
          "name": "CRM Guest List (All 17 Table Columns)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Has items and pagination', () => {",
                  "    pm.expect(res.data.items).to.be.an('array');",
                  "    pm.expect(res.data.pagination).to.be.an('object');",
                  "    if (res.data.items.length > 0) {",
                  "        const g = res.data.items[0];",
                  "        pm.expect(g).to.have.property('mobile');",
                  "        pm.expect(g).to.have.property('name');",
                  "        pm.expect(g).to.have.property('gender');",
                  "        pm.expect(g).to.have.property('totalOrders');",
                  "        pm.expect(g).to.have.property('totalPurchaseAmount');",
                  "        pm.expect(g).to.have.property('averagePurchaseAmount');",
                  "        pm.expect(g).to.have.property('onlineVisits');",
                  "        pm.expect(g).to.have.property('loyalty');",
                  "        pm.expect(g).to.have.property('advance');",
                  "        pm.expect(g).to.have.property('balance');",
                  "        pm.expect(g).to.have.property('membershipCount');",
                  "        pm.expect(g).to.have.property('hairType');",
                  "        pm.expect(g).to.have.property('store');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
