// ==========================================
// CRM MODULE: GUESTS (CUSTOMER MASTER)
// ==========================================

model Guest {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  guestCode    String?   @map("guest_code")
  salutation   String?
  salutationId String?   @map("salutation_id")
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  name         String
  displayName  String?   @map("display_name")
  gender       String? // "MALE" | "FEMALE" | "OTHER"
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date

  // Contact
  mobile          String
  alternateMobile String? @map("alternate_mobile")
  email           String?
  address         String? @db.Text
  city            String?
  state           String?
  country         String? @default("India")
  postalCode      String? @map("postal_code")

  // Personal Information
  anniversary DateTime? @db.Date
  gstNumber   String?   @map("gst_number")
  hairType    String?   @map("hair_type")
  preferences String?   @db.Text
  notes       String?   @db.Text
  tags        Json?     @default("[]")

  // Business / Customer Info
  customerType      String    @default("REGULAR") @map("customer_type") // "REGULAR" | "VIP" | "CORPORATE" | "WALK_IN"
  source            String? // "WALK_IN" | "REFERRAL" | "INSTAGRAM" | "GOOGLE" | "WEBSITE" | "OTHER"
  referralCode      String?   @map("referral_code")
  referredByGuestId String?   @map("referred_by_guest_id")
  crmSegmentId      String?   @map("crm_segment_id")
  membershipId      String?   @map("membership_id")
  membershipExpiry  DateTime? @map("membership_expiry")
  loyaltyPoints     Int       @default(0) @map("loyalty_points")
  advanceBalance    Decimal   @default(0) @map("advance_balance") @db.Decimal(12, 2)
  dueBalance        Decimal   @default(0) @map("due_balance") @db.Decimal(12, 2)
  membershipCount   Int       @default(0) @map("membership_count")
  store             String?   @default("kalyaninagar")
  totalSpend        Decimal   @default(0) @map("total_spend") @db.Decimal(12, 2)
  totalVisits       Int       @default(0) @map("total_visits")
  lastVisitDate     DateTime? @map("last_visit_date")

  // Status & Flags
  isActive    Boolean @default(true) @map("is_active")
  isBlocked   Boolean @default(false) @map("is_blocked")
  blockReason String? @map("block_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salutationRef   Salutation? @relation(fields: [salutationId], references: [id], onDelete: SetNull)
  crmSegmentRef   CrmSegment? @relation(fields: [crmSegmentId], references: [id], onDelete: SetNull)
  membershipRef   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  referredByGuest Guest?      @relation("GuestReferrals", fields: [referredByGuestId], references: [id], onDelete: SetNull)
  referrals       Guest[]     @relation("GuestReferrals")
  posOrders       PosOrder[]
  appointments    Appointment[]
  feedbacks       GuestFeedback[]
  guestMemberships GuestMembership[]
  guestPackages   GuestPackage[]
  walletTransactions GuestWalletTransaction[]
  followUps       GuestFollowUp[]
  enquiries       Enquiry[]
  guestNotes      GuestNote[]
  familyMembers   GuestFamilyMember[]
  formSubmissions GuestFormSubmission[]

  @@unique([tenantId, mobile])
  @@unique([tenantId, guestCode])
  @@index([tenantId])
  @@index([tenantId, mobile])
  @@index([tenantId, name])
  @@index([tenantId, email])
  @@index([tenantId, isActive])
  @@index([tenantId, isBlocked])
  @@index([tenantId, customerType])
  @@index([tenantId, crmSegmentId])
  @@index([tenantId, membershipId])
  @@map("guests")
}

// ==========================================
// MODULE: POS (POINT OF SALE)
// ==========================================

model PosOrder {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  orderNumber        String   @map("order_number") @db.VarChar(50)
  guestId            String   @map("guest_id")
  cashierId          String?  @map("cashier_id")
  status             String   @default("COMPLETED") // "COMPLETED" | "PENDING" | "CANCELLED"
  orderDate          DateTime @default(now()) @map("order_date")
  subtotal           Decimal  @default(0) @db.Decimal(12, 2)
  discountType       String?  @map("discount_type") // "PERCENTAGE" | "FIXED"
  discountValue      Decimal? @default(0) @map("discount_value") @db.Decimal(10, 2)
  discountAmount     Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  couponCode         String?  @map("coupon_code")
  couponDiscount     Decimal  @default(0) @map("coupon_discount") @db.Decimal(12, 2)
  giftCardCode       String?  @map("gift_card_code")
  giftCardAmount     Decimal  @default(0) @map("gift_card_amount") @db.Decimal(12, 2)
  referralCode       String?  @map("referral_code")
  referralDiscount   Decimal  @default(0) @map("referral_discount") @db.Decimal(12, 2)
  membershipDiscount Decimal  @default(0) @map("membership_discount") @db.Decimal(12, 2)
  loyaltyPointsRedeemed Int?     @default(0) @map("loyalty_points_redeemed")
  loyaltyDiscount       Decimal  @default(0) @map("loyalty_discount") @db.Decimal(12, 2)
  loyaltyPointsEarned   Int?     @default(0) @map("loyalty_points_earned")
  taxAmount          Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  taxRate            Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxDetails         Json?    @default("[]") @map("tax_details")
  tipAmount          Decimal  @default(0) @map("tip_amount") @db.Decimal(12, 2)
  totalAmount        Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  paymentMethod      String   @default("CASH") @map("payment_method") // "CASH" | "CARD" | "HDFC" | "GPAY" | "PHONEPE" | "BALANCE" | "SPLIT"
  paymentStatus      String   @default("PAID") @map("payment_status") // "PAID" | "PARTIAL" | "UNPAID"
  notes              String?  @db.Text
  instruction        String?  @db.Text
  invoicePdfUrl      String?  @map("invoice_pdf_url")
  whatsappStatus     String?  @default("PENDING") @map("whatsapp_status")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest    Guest          @relation(fields: [guestId], references: [id], onDelete: Restrict)
  cashier     User?          @relation("CashierPosOrders", fields: [cashierId], references: [id], onDelete: SetNull)
  items       PosOrderItem[]
  payments    PosPayment[]
  appointment Appointment?
  feedbacks   GuestFeedback[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, guestId])
  @@index([tenantId, cashierId])
  @@index([tenantId, status])
  @@index([tenantId, orderDate])
  @@index([tenantId, createdAt])
  @@map("pos_orders")
}

model PosOrderItem {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  orderId        String   @map("order_id")
  itemType       String   @default("SERVICE") @map("item_type") // "SERVICE" | "PRODUCT"
  serviceId      String?  @map("service_id")
  productId      String?  @map("product_id")
  staffId        String?  @map("staff_id")
  itemName       String   @map("item_name")
  itemCategory   String?  @map("item_category")
  quantity       Int      @default(1)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  staff   Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, orderId])
  @@index([tenantId, serviceId])
  @@index([tenantId, productId])
  @@index([tenantId, staffId])
  @@map("pos_order_items")
}

model PosPayment {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  orderId         String   @map("order_id")
  method          String // "CASH" | "CARD" | "HDFC" | "GPAY" | "PHONEPE" | "BALANCE"
  amount          Decimal  @db.Decimal(12, 2)
  referenceNumber String?  @map("reference_number")
  status          String   @default("SUCCESS")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, orderId])
  @@map("pos_payments")
}

// ==========================================
// MODULE 12: APPOINTMENTS & SCHEDULING (CALENDAR)
// ==========================================

model Appointment {
  id                 String            @id @default(uuid())
  tenantId           String            @map("tenant_id")
  appointmentNumber  String            @map("appointment_number") // e.g. "APT-20260826-0001"
  guestId            String            @map("guest_id")
  appointmentDate    DateTime          @map("appointment_date") @db.Date // Calendar day YYYY-MM-DD
  status             String            @default("CONFIRMED") @map("status") // "CONFIRMED" | "ONLINE" | "CHECKED_IN" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED" | "NO_SHOW"
  bookingSource      String            @default("WALK_IN") @map("booking_source") // "WALK_IN" | "ONLINE" | "PHONE"
  totalAmount        Decimal           @default(0) @map("total_amount") @db.Decimal(12, 2)
  instruction        String?           @map("instruction") @db.Text
  confirmationSms    Boolean           @default(true) @map("confirmation_sms")
  smsToOwner         Boolean           @default(true) @map("sms_to_owner")
  cancelledReason    String?           @map("cancelled_reason") @db.Text
  posOrderId         String?           @unique @map("pos_order_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest    Guest             @relation(fields: [guestId], references: [id], onDelete: Restrict)
  posOrder PosOrder?         @relation(fields: [posOrderId], references: [id], onDelete: SetNull)
  items    AppointmentItem[]

  @@unique([tenantId, appointmentNumber])
  @@index([tenantId])
  @@index([tenantId, guestId])
  @@index([tenantId, appointmentDate])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("appointments")
}

model AppointmentItem {
  id                 String      @id @default(uuid())
  tenantId           String      @map("tenant_id")
  appointmentId      String      @map("appointment_id")
  serviceId          String      @map("service_id")
  staffId            String?     @map("staff_id")
  resourceId         String?     @map("resource_id")
  startTime          String      @map("start_time") // e.g. "19:15"
  endTime            String      @map("end_time")   // e.g. "19:45"
  durationMinutes    Int         @default(30) @map("duration_minutes")
  price              Decimal     @default(0) @map("price") @db.Decimal(12, 2)
  isRecommendedStaff Boolean     @default(false) @map("is_recommended_staff")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff       Staff?      @relation(fields: [staffId], references: [id], onDelete: SetNull)
  resource    Resource?   @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, appointmentId])
  @@index([tenantId, serviceId])
  @@index([tenantId, staffId])
  @@index([tenantId, resourceId])
  @@map("appointment_items")
}

// ==========================================
// FEEDBACK & CRM EXTENSIONS
// ==========================================

model GuestFeedback {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  guestId   String   @map("guest_id")
  staffId   String?  @map("staff_id")
  orderId   String?  @map("order_id")
  rating    Int      @default(5)
  comment   String?  @db.Text
  answers   Json?    @default("[]")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest  Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  staff  Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  order  PosOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
