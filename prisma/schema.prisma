  productId        String?  @map("product_id")
  disposableId     String?  @map("disposable_id")
  type             String   // "INWARD" | "OUTWARD" | "CONSUMED" | "TRANSFER" | "RECONCILED"
  quantity         Decimal  @db.Decimal(10, 2)
  unitPrice        Decimal  @default(0) @map("unit_price") @db.Decimal(10, 2)
  totalAmount      Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  vendorName       String?  @map("vendor_name")
  poNumber         String?  @map("po_number")
  sourceStore      String?  @map("source_store")
  destinationStore String?  @map("destination_store")
  serviceId        String?  @map("service_id")
  staffId          String?  @map("staff_id")
  notes            String?  @db.Text
  transactionDate  DateTime @default(now()) @map("transaction_date") @db.Date
  createdAt        DateTime @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  disposable Disposable? @relation(fields: [disposableId], references: [id], onDelete: SetNull)
