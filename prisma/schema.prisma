// ==========================================
// CASH MANAGEMENT MODULE
// ==========================================

model CashTransaction {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  store          String    @default("kalyaninagar")
  date           DateTime  @default(now()) @db.Date
  status         String    @default("OPEN") // "OPEN" | "CLOSED"
  openingBalance Decimal   @default(0) @db.Decimal(12, 2) @map("opening_balance")
  cashRevenue    Decimal   @default(0) @db.Decimal(12, 2) @map("cash_revenue")
  cashExpense    Decimal   @default(0) @db.Decimal(12, 2) @map("cash_expense")
  closingBalance Decimal   @default(0) @db.Decimal(12, 2) @map("closing_balance")
  instoreCash    Decimal   @default(0) @db.Decimal(12, 2) @map("instore_cash")
  reconciliation Decimal   @default(0) @db.Decimal(12, 2)
  closingRemark  String?   @db.Text @map("closing_remark")
  createdById    String?   @map("created_by_id")
  updatedById    String?   @map("updated_by_id")
  updateRemark   String?   @db.Text @map("update_remark")
  closedAt       DateTime? @map("closed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
