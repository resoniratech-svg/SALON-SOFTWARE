  mobile          String
  email           String?
  priority        String    @default("LOW") // "LOW" | "MEDIUM" | "HIGH"
  status          String    @default("NEW") // "NEW" | "FOLLOWING_UP" | "IN_PROGRESS" | "CONVERTED" | "CANCELLED" | "DUPLICATE" | "LOST"
  service         String?
  serviceId       String?   @map("service_id")
  assignedStaffId String?   @map("assigned_staff_id")
  referralSource  String?   @map("referral_source")
  description     String?   @db.Text
  followUpDate    DateTime? @map("follow_up_date")
  createdById     String?   @map("created_by_id")
  lastUpdatedById String?   @map("last_updated_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
