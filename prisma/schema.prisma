  servicesPercent Decimal  @default(0) @map("services_percent") @db.Decimal(5, 2)
  servicesAmount  Decimal  @default(0) @map("services_amount") @db.Decimal(10, 2)
  totalValue      Decimal  @db.Decimal(12, 2) @map("total_value")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, poId])
  @@map("purchase_order_items")
}

// ==========================================
// INVENTORY MODULE: TRANSFER REQUESTS
