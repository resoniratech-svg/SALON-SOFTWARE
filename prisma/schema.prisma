}

model EnquiryFollowUp {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  enquiryId    String    @map("enquiry_id")
  followUpDate DateTime  @map("follow_up_date")
  notes        String?   @db.Text
  status       String    @default("PENDING") // "PENDING" | "COMPLETED" | "CANCELLED"
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("EnquiryFollowUpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([enquiryId])
  @@index([followUpDate])
  @@map("enquiry_follow_ups")
}

model EnquiryHistory {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  enquiryId     String   @map("enquiry_id")
  action        String   // "CREATED" | "UPDATED" | "STATUS_CHANGED" | "PRIORITY_CHANGED" | "FOLLOW_UP_ADDED" | "CONVERTED"
  fieldName     String?  @map("field_name")
  oldValue      String?  @map("old_value")
  newValue      String?  @map("new_value")
  notes         String?  @db.Text
  performedById String?  @map("performed_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiry     Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  performedBy User?    @relation("EnquiryHistoryPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([enquiryId])
  @@index([createdAt])
  @@map("enquiry_histories")
}

model Referral {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  store             String   @default("kalyaninagar")
  referralName      String   @map("referral_name")
  mobileNumber      String   @map("mobile_number")
  referredDate      DateTime @default(now()) @map("referred_date") @db.Date
  referrerGuestId   String?  @map("referrer_guest_id")
  referrerName      String?  @map("referrer_name")
  referralCode      String   @map("referral_code")
  status            String   @default("PENDING") // "PENDING" | "USED" | "EXPIRED"
  benefitToReferral String?  @map("benefit_to_referral")
  benefitToReferrer String?  @map("benefit_to_referrer")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, store])
  @@index([tenantId, status])
  @@index([tenantId, referralCode])
  @@map("referrals")
}

// ==========================================
// PAYROLL MODULE
// ==========================================

model PayrollConfig {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  staffId          String?  @map("staff_id")
  basicSalary      Decimal  @default(0) @db.Decimal(12, 2) @map("basic_salary")
  hra              Decimal  @default(0) @db.Decimal(12, 2)
  conveyance       Decimal  @default(0) @db.Decimal(12, 2)
  medicalAllowance Decimal  @default(0) @db.Decimal(12, 2) @map("medical_allowance")
  specialAllowance Decimal  @default(0) @db.Decimal(12, 2) @map("special_allowance")
  pfPercentage     Decimal  @default(0) @db.Decimal(5, 2) @map("pf_percentage")
  esiPercentage    Decimal  @default(0) @db.Decimal(5, 2) @map("esi_percentage")
  professionalTax  Decimal  @default(0) @db.Decimal(10, 2) @map("professional_tax")
  tdsPercentage    Decimal  @default(0) @db.Decimal(5, 2) @map("tds_percentage")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([tenantId, staffId])
  @@index([tenantId])
  @@map("payroll_configs")
}

model StaffSalary {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  staffId       String    @map("staff_id")
  month         Int       // 1 - 12
  year          Int       // 2026
  basicSalary   Decimal   @default(0) @db.Decimal(12, 2) @map("basic_salary")
  allowances    Decimal   @default(0) @db.Decimal(12, 2)
  deductions    Decimal   @default(0) @db.Decimal(12, 2)
  incentives    Decimal   @default(0) @db.Decimal(12, 2)
  bonuses       Decimal   @default(0) @db.Decimal(12, 2)
  grossSalary   Decimal   @default(0) @db.Decimal(12, 2) @map("gross_salary")
  netSalary     Decimal   @default(0) @db.Decimal(12, 2) @map("net_salary")
  workingDays   Int       @default(30) @map("working_days")
  presentDays   Int       @default(30) @map("present_days")
  status        String    @default("PENDING") // "PENDING" | "APPROVED" | "PAID"
  paidAt        DateTime? @map("paid_at")
  paymentMethod String?   @map("payment_method")
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([tenantId, staffId, month, year])
  @@index([tenantId])
  @@index([tenantId, month, year])
  @@map("staff_salaries")
}

// ==========================================
// WHATSAPP MODULE
// ==========================================

model WhatsAppConversation {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  recipientNumber String   @map("recipient_number")
  recipientName   String?  @map("recipient_name")
  lastMessage     String?  @db.Text @map("last_message")
  lastMessageAt   DateTime @default(now()) @map("last_message_at")
  unreadCount     Int      @default(0) @map("unread_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages WhatsAppMessage[]

  @@unique([tenantId, recipientNumber])
  @@index([tenantId])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  conversationId  String?   @map("conversation_id")
  direction       String    @default("OUTGOING") // "OUTGOING" | "INCOMING"
  recipientNumber String    @map("recipient_number")
  recipientName   String?   @map("recipient_name")
  messageContent  String    @db.Text @map("message_content")
  templateName    String?   @map("template_name")
  status          String    @default("SENT") // "QUEUED" | "SENT" | "DELIVERED" | "READ" | "FAILED"
  errorDetails    String?   @db.Text @map("error_details")
  sentAt          DateTime  @default(now()) @map("sent_at")
  deliveredAt     DateTime? @map("delivered_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation WhatsAppConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, conversationId])
  @@index([tenantId, recipientNumber])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("whatsapp_messages")
}

// ==========================================
// SAAS PLATFORM SUBSCRIPTION PLANS
// ==========================================
model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String   @unique
  price        Decimal  @db.Decimal(10, 2)
  durationDays Int      @map("duration_days")
  billingCycle String?  @map("billing_cycle")
  badgeTag     String?  @map("badge_tag")
  cashierLimit Int      @default(2) @map("cashier_limit")
  features     Json?    @default("[]")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("subscription_plans")
}


