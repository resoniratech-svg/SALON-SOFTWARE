  updatedBy User?  @relation("CashTransactionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, store])
  @@index([tenantId, status])
  @@index([tenantId, date])
  @@map("cash_transactions")
}

