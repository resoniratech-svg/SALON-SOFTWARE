datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// SAAS MULTI-TENANCY FOUNDATION
// ==========================================

model Tenant {
  id                    String    @id @default(uuid())
  name                  String
  code                  String    @unique
  isActive              Boolean   @default(true) @map("is_active")
  plan                  String    @default("TRIAL") // "TRIAL" | "STARTER" | "PRO" | "ENTERPRISE"
  subscriptionStatus    String    @default("TRIAL") @map("subscription_status") // "TRIAL" | "ACTIVE" | "EXPIRED" | "SUSPENDED"
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")
  trialEndsAt           DateTime? @map("trial_ends_at")
  expiryAlertDays       Int       @default(7) @map("expiry_alert_days")
  cashierLimit          Int       @default(2) @map("cashier_limit")
  enabledModules        Json?     @default("[\"SERVICES\",\"PRODUCTS\",\"DISPOSABLES\",\"STAFF\"]") @map("enabled_modules")
  cashierPermissions    Json?     @default("{}") @map("cashier_permissions")
  contactEmail          String?   @map("contact_email")
  contactPhone          String?   @map("contact_phone")
  address               String?
  city                  String?
  primaryBranchName     String?   @map("primary_branch_name")
  logoUrl               String?   @map("logo_url") @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  users             User[]
  staff             Staff[]
  designations      Designation[]
  shifts            Shift[]
  serviceCategories ServiceCategory[]
  services          Service[]
  productCategories ProductCategory[]
  products          Product[]
  disposables       Disposable[]
  resources         Resource[]
  auditLogs         AuditLog[]
  tenantSettings    TenantSettings?
  taxMappings       TaxMapping[]
  memberships       Membership[]
  packages          Package[]
  giftCards         GiftCard[]
  coupons           Coupon[]
  pnlCategories     PnlCategory[]
  pnlIncomeTaxes    PnlIncomeTax[]
  crmSegments       CrmSegment[]
  customForms       CustomForm[]
  salutations       Salutation[]
  guests            Guest[]
  posOrders           PosOrder[]
  posOrderItems       PosOrderItem[]
  posPayments         PosPayment[]
  appointments        Appointment[]
  appointmentItems    AppointmentItem[]
  guestFeedbacks      GuestFeedback[]
  stockTransactions   StockTransaction[]
  expenseTransactions ExpenseTransaction[]
  vendors             Vendor[]
  vendorItems         VendorItem[]
  purchaseOrders      PurchaseOrder[]
  purchaseOrderItems  PurchaseOrderItem[]
  transferRequests    TransferRequest[]
  transferRequestItems TransferRequestItem[]
  guestMemberships    GuestMembership[]
  guestPackages       GuestPackage[]
  guestWalletTransactions GuestWalletTransaction[]
  guestFollowUps      GuestFollowUp[]
  guestNotes          GuestNote[]
  guestFamilyMembers  GuestFamilyMember[]
  guestFormSubmissions GuestFormSubmission[]
  cashTransactions    CashTransaction[]
  expenseTypes        ExpenseType[]
  financialAccounts   FinancialAccount[]
  accountTransactions AccountTransaction[]
  enquiries           Enquiry[]
  enquiryFollowUps    EnquiryFollowUp[]
  enquiryHistories    EnquiryHistory[]
  referrals           Referral[]
  payrollConfigs      PayrollConfig[]
  staffSalaries       StaffSalary[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppMessages    WhatsAppMessage[]

  @@map("tenants")
}

// ==========================================
// MODULE 01: AUTHENTICATION & ACCESS CONTROL
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  users           User[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  module          String
  action          String
  code            String           @unique
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                       String     @id @default(uuid())
  tenantId                 String?    @map("tenant_id")
  tenant                   Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username                 String     @unique
  email                    String?    @unique
  phone                    String?    @unique
  passwordHash             String     @map("password_hash")
  roleId                   String     @map("role_id")
  role                     Role       @relation(fields: [roleId], references: [id])
  status                   UserStatus @default(ACTIVE)
  isSuperAdmin             Boolean    @default(false) @map("is_super_admin")
  enabledModules           Json?      @default("[]") @map("enabled_modules")
  mustChangePassword       Boolean    @default(false) @map("must_change_password")
  passwordResetRequested   Boolean    @default(false) @map("password_reset_requested")
  passwordResetRequestedAt DateTime?  @map("password_reset_requested_at")
  resetPasswordToken       String?    @map("reset_password_token")
  resetPasswordExpiresAt   DateTime?  @map("reset_password_expires_at")
  lastLoginAt              DateTime?  @map("last_login_at")
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")
  handledPosOrders         PosOrder[]        @relation("CashierPosOrders")
  createdCashTransactions  CashTransaction[] @relation("CashTransactionCreatedBy")
  updatedCashTransactions  CashTransaction[] @relation("CashTransactionUpdatedBy")
  createdEnquiries         Enquiry[]         @relation("EnquiryCreatedBy")
  updatedEnquiries         Enquiry[]         @relation("EnquiryUpdatedBy")
  createdEnquiryFollowUps  EnquiryFollowUp[] @relation("EnquiryFollowUpCreatedBy")
  performedEnquiryHistories EnquiryHistory[] @relation("EnquiryHistoryPerformedBy")

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actorType  String   @map("actor_type") // "SUPERADMIN" | "ADMIN"
  actorName  String   @map("actor_name")
  tenantId   String?  @map("tenant_id")
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?    @default("{}")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// MODULE 02: STAFF AGENT / STAFF MANAGEMENT
// ==========================================

// Pre-requisite relationship from Settings: Designation
model Designation {
  id                  String               @id @default(uuid())
  tenantId            String               @map("tenant_id")
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  staffJoiningDetails StaffJoiningDetail[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("designations")
}

// Pre-requisite relationship from Settings: Shift Management
model Shift {
  id                   String                @id @default(uuid())
  tenantId             String                @map("tenant_id")
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  isActive             Boolean               @default(true) @map("is_active")
  startTime            String                @map("start_time")
  endTime              String                @map("end_time")
  timings              Json?                 @default("[]")
  breaks               Json?                 @default("[]")
  staffWeeklySchedules StaffWeeklySchedule[]
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("shifts")
}

// Core Staff Entity
model Staff {
  id                  String                   @id @default(uuid())
  tenantId            String                   @map("tenant_id")
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  isActive            Boolean                  @default(true) @map("is_active")
  personalDetails     StaffPersonalDetail?
  documents           StaffDocument[]
  joiningDetails      StaffJoiningDetail?      @relation("StaffJoining")
  bankDetails         StaffBankDetail?
  appointmentSettings StaffAppointmentSetting?
  weeklySchedules     StaffWeeklySchedule[]
  subordinates        StaffJoiningDetail[]     @relation("ReportingManager")
  serviceStaff        ServiceStaff[]
  posOrderItems       PosOrderItem[]
  appointmentItems    AppointmentItem[]
  guestFeedbacks      GuestFeedback[]
  stockTransactions   StockTransaction[]
  guestMemberships    GuestMembership[]
  guestFollowUps      GuestFollowUp[]
  guestNotes          GuestNote[]
  guestWalletTransactions GuestWalletTransaction[]
  guestFormSubmissions GuestFormSubmission[]
  expenseTransactions ExpenseTransaction[]
  payrollConfigs      PayrollConfig[]
  staffSalaries       StaffSalary[]
  assignedEnquiries   Enquiry[]                @relation("EnquiryAssignedStaff")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("staff")
}

// Section 1: Personal Details
model StaffPersonalDetail {
  id                     String    @id @default(uuid())
  staffId                String    @unique @map("staff_id")
  staff                  Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  firstName              String    @map("first_name")
  lastName               String    @map("last_name")
  displayName            String?   @map("display_name")
  gender                 String?
  dob                    DateTime?
  mobile                 String
  email                  String?
  address                String?
  emergencyContactName   String?   @map("emergency_contact_name")
  emergencyContactNumber String?   @map("emergency_contact_number")
  avatarUrl              String?   @map("avatar_url")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("staff_personal_details")
}

// Section 2: Documents
model StaffDocument {
  id             String   @id @default(uuid())
  staffId        String   @map("staff_id")
  staff          Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  documentType   String   @map("document_type")
  documentNumber String?  @map("document_number")
  documentUrl    String   @map("document_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("staff_documents")
}

// Section 3: Joining Details
model StaffJoiningDetail {
  id             String      @id @default(uuid())
  staffId        String      @unique @map("staff_id")
  staff          Staff       @relation("StaffJoining", fields: [staffId], references: [id], onDelete: Cascade)
  joiningDate    DateTime    @map("joining_date")
  designationId  String      @map("designation_id")
  designation    Designation @relation(fields: [designationId], references: [id])
  employeeNumber String      @map("employee_number")
  reportingToId  String?     @map("reporting_to_id")
  reportingTo    Staff?      @relation("ReportingManager", fields: [reportingToId], references: [id])
  workingHours   String      @map("working_hours")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@map("staff_joining_details")
}

// Section 4: Bank Details
model StaffBankDetail {
  id            String   @id @default(uuid())
  staffId       String   @unique @map("staff_id")
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  bankName      String   @map("bank_name")
  branch        String
  accountNumber String   @map("account_number")
  ifsc          String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("staff_bank_details")
}

// Section 5: Appointment Settings
model StaffAppointmentSetting {
  id                  String   @id @default(uuid())
  staffId             String   @unique @map("staff_id")
  staff               Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  enableAppointments  Boolean  @default(true) @map("enable_appointments")
  showAllAppointments Boolean  @default(false) @map("show_all_appointments")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("staff_appointment_settings")
}

// Section 6: Weekly Schedule
model StaffWeeklySchedule {
  id          String   @id @default(uuid())
  staffId     String   @map("staff_id")
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      @map("day_of_week") // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  shiftId     String?  @map("shift_id")
  shift       Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  isWeeklyOff Boolean  @default(false) @map("is_weekly_off")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([staffId, dayOfWeek])
  @@map("staff_weekly_schedules")
}

// ==========================================
// MODULE 03: SERVICE CATEGORIES
// ==========================================

model ServiceCategory {
  id                  String            @id @default(uuid())
  tenantId            String            @map("tenant_id")
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentId            String?           @map("parent_id")
  parent              ServiceCategory?  @relation("ServiceCategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children            ServiceCategory[] @relation("ServiceCategoryHierarchy")
  name                String
  position            Int               @default(0)
  group               String            @default("Both") // "Both" | "Female" | "Male"
  hideFromCatalogue   Boolean           @default(false) @map("hide_from_catalogue")
  imageUrl            String?           @map("image_url")
  stores              Json?             @default("[]")
  isActive            Boolean           @default(true) @map("is_active")
  services            Service[]
  subcategoryServices Service[]         @relation("ServiceSubcategory")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([parentId])
  @@index([name])
  @@index([isActive])
  @@index([position])
  @@map("service_categories")
}

// ==========================================
// MODULE 04: SERVICES
// ==========================================

model Service {
  id                  String           @id @default(uuid())
  tenantId            String           @map("tenant_id")
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId          String           @map("category_id")
  category            ServiceCategory  @relation(fields: [categoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  subcategoryId       String?          @map("subcategory_id")
  subcategory         ServiceCategory? @relation("ServiceSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  name                String
  description         String?
  price               Decimal          @db.Decimal(10, 2)
  salePrice           Decimal?         @default(0) @map("sale_price") @db.Decimal(10, 2)
  durationMinutes     Int              @default(0) @map("duration_minutes")
  hour                Int              @default(0)
  minute              Int              @default(0)
  serviceReminderDays Int              @default(0) @map("service_reminder_days")
  sacCode             String?          @map("sac_code")
  serviceTag          String?          @map("service_tag")
  group               String? // "Both" | "Female" | "Male" (optional)
  hideFromCatalogue   Boolean          @default(false) @map("hide_from_catalogue")
  isNonDiscountable   Boolean          @default(false) @map("is_non_discountable")
  position            Int              @default(0)
  imageUrl            String?          @map("image_url")
  isActive            Boolean          @default(true) @map("is_active")
  consumables         Json?            @default("[]")
  resourceIds         Json?            @default("[]") @map("resource_ids")
  serviceStaff        ServiceStaff[]
  posOrderItems       PosOrderItem[]
  appointmentItems    AppointmentItem[]
  enquiries           Enquiry[]
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@unique([id, tenantId])
  @@unique([tenantId, categoryId, name])
  @@index([tenantId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([name])
  @@index([isActive])
  @@index([position])
  @@map("services")
}

model ServiceStaff {
  id            String   @id @default(uuid())
  serviceId     String   @map("service_id")
  staffId       String   @map("staff_id")
  isRecommended Boolean  @default(false) @map("is_recommended")
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([serviceId, staffId])
  @@map("service_staff")
}

// ==========================================
// MODULE 05: PRODUCT CATEGORIES
// ==========================================

model ProductCategory {
  id                  String            @id @default(uuid())
  tenantId            String            @map("tenant_id")
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentId            String?           @map("parent_id")
  parent              ProductCategory?  @relation("ProductCategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children            ProductCategory[] @relation("ProductCategoryHierarchy")
  name                String
  position            Int               @default(0)
  group               String            @default("Both") // "Both" | "Female" | "Male"
  hideFromCatalogue   Boolean           @default(false) @map("hide_from_catalogue")
  imageUrl            String?           @map("image_url")
  stores              Json?             @default("[]")
  isActive            Boolean           @default(true) @map("is_active")
  products            Product[]
  subcategoryProducts Product[]         @relation("ProductSubcategory")
  disposables         Disposable[]
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([parentId])
  @@index([name])
  @@index([isActive])
  @@index([position])
  @@map("product_categories")
}

// ==========================================
// MODULE 06: PRODUCTS
// ==========================================

model Product {
  id                String           @id @default(uuid())
  tenantId          String           @map("tenant_id")
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId        String           @map("category_id")
  category          ProductCategory  @relation(fields: [categoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  subcategoryId     String?          @map("subcategory_id")
  subcategory       ProductCategory? @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  name              String
  position          Int              @default(0)
  hsnCode           String?          @map("hsn_code")
  productTag        String?          @map("product_tag")
  storeSku          String?          @map("store_sku")
  isRetail          Boolean          @default(true) @map("is_retail")
  group             String           @default("Both") // "Both" | "Female" | "Male"
  hideFromCatalogue Boolean          @default(false) @map("hide_from_catalogue")
  price             Decimal          @db.Decimal(10, 2)
  salePrice         Decimal?         @default(0) @map("sale_price") @db.Decimal(10, 2)
  purchasePrice     Decimal?         @default(0) @map("purchase_price") @db.Decimal(10, 2)
  isNonDiscountable Boolean          @default(false) @map("is_non_discountable")
  description       String?
  barcode           String?
  supplierId        String?          @map("supplier_id")
  supplier          Vendor?          @relation("ProductSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  variations        Json?            @default("[]")
  taxes             Json?            @default("[]")
  videoLink         String?          @map("video_link")
  benefits          String?
  ingredients       String?
  usageInstructions String?          @map("usage_instructions")
  displayImages     Json?            @default("[]") @map("display_images")
  isActive          Boolean          @default(true) @map("is_active")
  posOrderItems     PosOrderItem[]
  stockTransactions StockTransaction[]
  vendorItems       VendorItem[]
  poItems           PurchaseOrderItem[]
  trItems           TransferRequestItem[]
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@unique([id, tenantId])
  @@unique([tenantId, categoryId, name])
  @@unique([tenantId, barcode])
  @@unique([tenantId, storeSku])
  @@index([tenantId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([supplierId])
  @@index([name])
  @@index([isActive])
  @@index([position])
  @@map("products")
}

// ==========================================
// MODULE 07: DISPOSABLES
// ==========================================

model Disposable {
  id                String           @id @default(uuid())
  tenantId          String           @map("tenant_id")
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  code              String?
  category          String           @default("Disposables")
  categoryId        String?          @map("category_id")
  productCategory   ProductCategory? @relation(fields: [categoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  price             Decimal          @default(0) @db.Decimal(10, 2)
  salePrice         Decimal?         @default(0) @map("sale_price") @db.Decimal(10, 2)
  quantity          Decimal          @default(1) @db.Decimal(10, 2)
  unit              String           @default("pcs")
  gender            String           @default("Both") // "Both" | "Female" | "Male"
  isRetail          Boolean          @default(false) @map("is_retail")
  hideFromCatalogue Boolean          @default(false) @map("hide_from_catalogue")
  isNonDiscountable Boolean          @default(false) @map("is_non_discountable")
  description       String?
  barcode           String?
  position          Int              @default(0)
  hsnCode           String?          @map("hsn_code")
  productTag        String?          @map("product_tag")
  isActive          Boolean          @default(true) @map("is_active")
  stockTransactions StockTransaction[]
  vendorItems       VendorItem[]
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@unique([id, tenantId])
  @@unique([tenantId, category, name])
  @@unique([tenantId, barcode])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([name])
  @@index([category])
  @@index([categoryId])
  @@index([isActive])
  @@index([position])
  @@map("disposables")
}

// ==========================================
// MODULE: RESOURCES / ROOMS / STATIONS
// ==========================================

model Resource {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  capacity    Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentItems AppointmentItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([name])
  @@index([isActive])
  @@map("resources")
}

// ==========================================
// MODULE 10: SETTINGS MODULE
// ==========================================

model TenantSettings {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Generic / Business Settings
  businessStatus      String @default("OPEN") @map("business_status") // "OPEN" | "CLOSED"
  openingTime         String @default("08:00 AM") @map("opening_time")
  closingTime         String @default("11:30 PM") @map("closing_time")
  genderSpecification String @default("Both") @map("gender_specification") // "Both" | "Female" | "Male"
  weeklyOffDays       Json?  @default("[]") @map("weekly_off_days")

  // Product Ordering Settings
  homeDeliveryEnabled Boolean @default(true) @map("home_delivery_enabled")
  pickupEnabled       Boolean @default(true) @map("pickup_enabled")
  codEnabled          Boolean @default(true) @map("cod_enabled")
  cashOnPickupEnabled Boolean @default(true) @map("cash_on_pickup_enabled")
  minOrderValue       Decimal @default(0) @map("min_order_value") @db.Decimal(10, 2)
  deliveryFee         Decimal @default(0) @map("delivery_fee") @db.Decimal(10, 2)

  // Online Payment Settings
  onlinePaymentEnabled Boolean @default(false) @map("online_payment_enabled")
  paymentGateways      Json?   @default("[]") @map("payment_gateways")
  applyToOrders        Boolean @default(true) @map("apply_to_orders")
  applyToAppointments  Boolean @default(true) @map("apply_to_appointments")

  // Notification Settings
  notificationsConfig Json? @default("{}") @map("notifications_config")

  // Feedback Settings
  feedbackEnabled   Boolean @default(true) @map("feedback_enabled")
  ratingScale       Int     @default(5) @map("rating_scale")
  sendFeedbackSms   Boolean @default(false) @map("send_feedback_sms")
  sendFeedbackEmail Boolean @default(false) @map("send_feedback_email")
  feedbackQuestions Json?   @default("[]") @map("feedback_questions")

  // Referral Settings
  referralsEnabled     Boolean  @default(false) @map("referrals_enabled")
  referrerRewardType   String?  @map("referrer_reward_type")
  referrerRewardValue  Decimal? @map("referrer_reward_value") @db.Decimal(10, 2)
  refereeRewardType    String?  @map("referee_reward_type")
  refereeRewardValue   Decimal? @map("referee_reward_value") @db.Decimal(10, 2)
  referralMinOrder     Decimal? @map("referral_min_order") @db.Decimal(10, 2)
  referralValidityDays Int?     @map("referral_validity_days")

  // Loyalty Settings
  loyaltyEnabled          Boolean  @default(false) @map("loyalty_enabled")
  pointsPerCurrency       Decimal? @default(1) @map("points_per_currency") @db.Decimal(10, 2)
  currencyPerPoint        Decimal? @default(1) @map("currency_per_point") @db.Decimal(10, 2)
  minRedeemPoints         Int?     @default(100) @map("min_redeem_points")
  maxRedeemPointsPerOrder Int?     @map("max_redeem_points_per_order")
  loyaltyExpiryDays       Int?     @map("loyalty_expiry_days")
  loyaltyRules            Json?    @default("{}") @map("loyalty_rules")

  // Incentive Settings
  incentiveEnabled         Boolean @default(false) @map("incentive_enabled")
  incentiveCalculationType String? @map("incentive_calculation_type")
  incentiveRules           Json?   @default("[]") @map("incentive_rules")

  // Footer Content
  footerText  String? @map("footer_text")
  footerLinks Json?   @default("[]") @map("footer_links")
  contactInfo Json?   @default("{}") @map("contact_info")

  // Legal Content
  privacyPolicy      String? @map("privacy_policy") @db.Text
  termsAndConditions String? @map("terms_and_conditions") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("tenant_settings")
}

