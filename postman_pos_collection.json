          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Contains all 5 status counters\", function () {",
                  "    var data = pm.response.json().data;",
                  "    pm.expect(data).to.have.property(\"new\");",
                  "    pm.expect(data).to.have.property(\"accepted\");",
                  "    pm.expect(data).to.have.property(\"rejected\");",
                  "    pm.expect(data).to.have.property(\"completed\");",
                  "    pm.expect(data).to.have.property(\"total\");",
                  "});"
