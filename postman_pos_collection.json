    {
      "name": "03. POS Cart Calculation Engine",
      "item": [
        {
          "name": "1. Calculate Cart Checkout (Dynamic Line Items, Discounts & Taxes)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Calculation contains line items breakdown with taxes\", function () {",
                  "    var data = pm.response.json().data;",
                  "    pm.expect(data.itemsCalculated).to.be.an(\"array\");",
                  "    var item = data.itemsCalculated[0];",
                  "    pm.expect(item).to.have.property(\"taxExclusiveSubtotal\");",
                  "    pm.expect(item).to.have.property(\"taxAmount\");",
                  "    pm.expect(item).to.have.property(\"taxRate\");",
                  "    pm.expect(data).to.have.property(\"totalAmount\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guestId\": \"{{guestId}}\",\n  \"items\": [\n    {\n      \"itemType\": \"SERVICE\",\n      \"serviceId\": \"{{serviceId}}\",\n      \"staffId\": \"{{staffId}}\",\n      \"quantity\": 1,\n      \"unitPrice\": 800,\n      \"discountAmount\": 0\n    }\n  ],\n  \"discountType\": \"PERCENTAGE\",\n  \"discountValue\": 10,\n  \"tipAmount\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pos/calculate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pos",
                "calculate"
              ]
